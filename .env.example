# Configurações do Provedor LLM (Google Gemini)
# Obtenha sua chave em: https://aistudio.google.com/
GOOGLE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Tracing e Observabilidade (Opcional - LangSmith / LangFuse)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=gb-support-agent

# Circuit Breaker e Parâmetros da Aplicação
CIRCUIT_BREAKER_LIMIT=5

# Estado das Sessões (Checkpointer LangGraph). Vazio = MemorySaver (dev/testes).
# No docker-compose o valor é injetado automaticamente (redis://redis:6379).
REDIS_URL=
CHECKPOINT_TTL_MINUTES=1440

# Minimização de PII: segredo usado para pseudonimizar o CPF enviado ao LangFuse
PII_HASH_SALT=troque-este-valor
